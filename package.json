{
  "name": "elderindex-website",
  "version": "1.0.0",
  "private": true,
  "description": "Independent ElderIndex website, built from the 2026 Webflow design and content",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && python3 -m http.server 4173 -d dist",
    "check": "node scripts/check.mjs",
    "test": "node scripts/test.mjs",
    "social:build": "node scripts/render-social.mjs",
    "audit:links": "python3 scripts/audit-internal-links.py"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1"
  }
}

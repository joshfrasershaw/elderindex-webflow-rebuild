{
  "name": "elderindex-private-cms",
  "account_id": "c27156f8f3cc29038495bf64fbf2bae7",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "../build", "binding": "ASSETS", "run_worker_first": true},
  "durable_objects": {"bindings": [{"name": "CMS_STATE", "class_name": "CmsState"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["CmsState"]}],
  "vars": {
    "PUBLIC_ORIGIN": "https://cms.elderindex.co.uk",
    "ACCESS_ISSUER": "https://blue-hill-f7a1.cloudflareaccess.com",
    "ACCESS_AUD": "c0767b3aa90d27b6e79950eee4544c6e8f7a4c64215dbe925f42c397ab841be3",
    "ALLOWED_EMAILS": "josh@elderindex.co.uk,joshfrasershaw@gmail.com"
  },
  "routes": [{"pattern": "cms.elderindex.co.uk", "custom_domain": true}]
}
